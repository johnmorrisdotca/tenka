{
  "name": "@johnmorrisdotca/tenka",
  "version": "2.1.2",
  "description": "Tenka \u5929\u4e0b \u2014 World conquest strategy game: seeded rules for two to six, world and Europe maps, dice, cards, saved games and a playable table for React, Vue, Svelte, Angular or plain HTML. Zero dependencies.",
  "keywords": [
    "ai",
    "angular",
    "board-game",
    "boardgame",
    "bot",
    "browser-game",
    "cards",
    "computer-player",
    "conquest",
    "csv",
    "custom-element",
    "dark-mode",
    "deterministic",
    "dice",
    "dice-battle",
    "dom",
    "esm",
    "export",
    "game",
    "game-engine",
    "game-logic",
    "hotseat",
    "html5-game",
    "i18n",
    "import",
    "japanese",
    "javascript",
    "json",
    "map",
    "map-game",
    "multiplayer",
    "natural-earth",
    "pass-and-play",
    "prng",
    "react",
    "react-component",
    "replay",
    "risk",
    "risk-game",
    "risk-like",
    "rules-engine",
    "save-game",
    "seeded",
    "strategy",
    "strategy-game",
    "svelte",
    "svg",
    "svg-map",
    "tabletop",
    "territory",
    "territory-control",
    "theming",
    "turn-based",
    "typescript",
    "vanilla-js",
    "vue",
    "war-game",
    "wargame",
    "web-component",
    "world-conquest",
    "world-domination",
    "world-map",
    "zero-dependencies"
  ],
  "homepage": "https://johnmorrisdotca.github.io/tenka/",
  "bugs": {
    "url": "https://github.com/johnmorrisdotca/tenka/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmorrisdotca/tenka.git"
  },
  "license": "MIT",
  "author": "John Morris",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./shapes": {
      "types": "./dist/shapes.d.ts",
      "import": "./dist/shapes.js",
      "default": "./dist/shapes.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js",
      "default": "./dist/ui.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./dressing": {
      "types": "./dist/dressing.d.ts",
      "import": "./dist/dressing.js",
      "default": "./dist/dressing.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "default": "./dist/element.js"
    },
    "./element/define": {
      "types": "./dist/element-define.d.ts",
      "import": "./dist/element-define.js",
      "default": "./dist/element-define.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "sideEffects": [
    "./dist/element-define.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:table": "pnpm test:demo",
    "test:package": "pnpm build && node scripts/check-package.mjs",
    "family:readme": "node scripts/family-readme.mjs",
    "test:frameworks": "pnpm build && node scripts/check-frameworks.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "site": "pnpm build && node scripts/site.mjs",
    "docs:make": "node scripts/docs.mjs",
    "map": "node scripts/map.mjs",
    "prepublishOnly": "pnpm check && pnpm build",
    "screenshots:readme": "pnpm site && node scripts/readme-pictures.mjs",
    "test:readme": "pnpm build && node scripts/check-readme-examples.mjs",
    "docs:site": "pnpm build && node scripts/docs-site.mjs build",
    "docs:check": "pnpm build && node scripts/docs-site.mjs check",
    "size": "node scripts/docs-site.mjs size",
    "test:demo": "pnpm site && node scripts/docs-site.mjs build && playwright test"
  },
  "peerDependencies": {
    "@johnmorrisdotca/korokoro": ">=1.15.0 <2",
    "@johnmorrisdotca/toranpu": ">=2.14.0 <3",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@johnmorrisdotca/korokoro": {
      "optional": true
    },
    "@johnmorrisdotca/toranpu": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@johnmorrisdotca/korokoro": "1.15.0",
    "@johnmorrisdotca/toranpu": "2.14.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^16.0.0",
    "react": "^19.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0",
    "pagefind": "^1.5.2",
    "marked": "^18.0.0",
    "esbuild": "^0.28.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.11.0"
}
